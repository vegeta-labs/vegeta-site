{
  "name": "vegeta-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "goten:fetch": "node scripts/fetch-goten.mjs",
    "trunks:fetch": "node scripts/fetch-trunks.mjs",
    "site:build": "rolldown site-src/site.js -f iife -m -o site/site.js",
    "site:share": "node scripts/render-share-card.mjs",
    "site:check": "node scripts/check-site.mjs",
    "site:preview": "node scripts/site-preview.mjs 4181",
